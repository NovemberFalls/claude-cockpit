{
  "identifier": "default",
  "description": "Default capabilities for Plexar Studio",
  "windows": ["main", "popout-*"],
  "remote": {
    "urls": ["http://localhost:8420/*"]
  },
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-open",
    "updater:default",
    "process:allow-restart",
    "dialog:allow-open"
  ]
}
